# Docker Compose defaults. Do not place real credentials in this file.
POSTGRES_DB=a_share_quant_lab
POSTGRES_USER=a_share_quant
POSTGRES_PASSWORD=change-me-for-local-use
DATABASE_URL=postgresql+psycopg://a_share_quant:change-me-for-local-use@postgres:5432/a_share_quant_lab
REDIS_URL=redis://redis:6379/0
APP_ENV=development
LOG_LEVEL=INFO
BACKTEST_REPOSITORY=sql
BACKTEST_MARKET_DATA=fixture
TASK_EXECUTION_MODE=celery
MARKET_DATA_PROVIDER=fixture
TUSHARE_TOKEN=
MAX_ORDER_NOTIONAL=1000000